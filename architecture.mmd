graph TD
    classDef root fill:#111,stroke:#fff,stroke-width:4px,color:#fff,font-size:16px,font-weight:bold
    classDef auth fill:#eab308,stroke:#111,stroke-width:3px,color:#111,font-weight:bold
    classDef core fill:#3b82f6,stroke:#111,stroke-width:3px,color:#fff,font-weight:bold
    classDef sub fill:#1f2937,stroke:#111,stroke-width:2px,color:#fff
    classDef api fill:#22c55e,stroke:#111,stroke-width:3px,color:#fff,font-weight:bold

    A[AlgoNova Landing Page]:::root
    
    B[Authentication]:::auth
    B1(Login / Register):::sub
    B2(Google OAuth):::sub
    
    C[Main Dashboard]:::core
    
    D[Visualizer HQ]:::core
    E[Algorithm Race]:::core
    F[Practice Arena]:::core
    G[Interview Prep]:::core
    H[System Design]:::core
    I[Resume Screener]:::core
    J[Leaderboard & Gamification]:::core

    D1(Sorting Visualizer):::sub
    D2(Searching, Trees, Graphs):::sub
    D3(Code Tracer):::sub
    
    G1(Speech-to-Text):::sub
    G2(AI Interviewer Feedback):::sub
    
    API((Node.js + Express Backend)):::api
    DB[(MongoDB Database)]:::api
    
    A --> B
    B --- B1
    B --- B2
    B -->|Success| C
    
    C --> D
    C --> E
    C --> F
    C --> G
    C --> H
    C --> I
    C --> J
    
    D --- D1
    D --- D2
    D1 --> D3
    
    G --- G1
    G --- G2
    
    B -.->|Auth Requests| API
    C -.->|Fetch User Data| API
    F -.->|Submit Code| API
    G -.->|AI Processing| API
    I -.->|Upload PDF| API
    
    API <--> DB
